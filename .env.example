# Copy to .env locally and fill from the secret store / vault at deploy time.
# NEVER commit real values. This file carries variable NAMES and harmless
# defaults only. Full documentation for each variable: src/config.ts.

# --- Recall.ai (pilot bot layer) ---
# Workspace API key, sent as "Authorization: Token <key>".
RECALL_API_KEY=
# Workspace region; fixes the API base host. Mathwhiz workspace: us-west-2.
RECALL_REGION=us-west-2
# Workspace webhook signing secret (server only; webhooks fail closed without it).
RECALL_WEBHOOK_SECRET=
# Live event delivery mode. Pilot implements "webhook" only.
RECALL_REALTIME_MODE=webhook
# Public https URL of this service; Recall posts realtime webhooks here.
PUBLIC_BASE_URL=

# --- Mathwhiz platform (draft endpoint) ---
PLATFORM_BASE_URL=https://app.mathwhizacademy.com
# The platform's existing assistant secret (a reference to the secret store,
# injected via env; never copied into this repo).
MATHWHIZ_ASSISTANT_SECRET=

# --- Service ---
PORT=8787
BOT_DISPLAY_NAME=Assistant Teacher (AI)
TRANSCRIPT_PROVIDER=recallai_streaming
